# Public Sanity connection details (safe to expose to the browser)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-29
NEXT_PUBLIC_SITE_URL=https://example.com

# Server-only token: create a least-privilege Sanity Viewer token.
SANITY_API_READ_TOKEN=

# Shared secret sent by the Sanity webhook to POST /api/revalidate.
SANITY_REVALIDATE_SECRET=
